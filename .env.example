# PitchForge Environment Configuration

# Miro Workspace Integration
# Optional: If not provided, PitchForge seamlessly uses the rich Demo Miro Board mode
MIRO_ACCESS_TOKEN=
MIRO_CLIENT_ID=
MIRO_CLIENT_SECRET=
MIRO_BOARD_ID=

# Qwen AI Reasoning Provider
# Compatible with Alibaba Cloud DashScope, OpenRouter, or OpenAI-compatible Qwen endpoints
# If not provided, PitchForge uses the comprehensive Built-in Qwen Reasoning Engine
QWEN_API_KEY=
QWEN_MODEL=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Text-to-Speech (TTS) Provider
# Optional: Supports elevenlabs, openai, or browser speech synthesis
TTS_API_KEY=
TTS_PROVIDER=web-speech
